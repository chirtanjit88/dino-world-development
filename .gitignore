# ==========================================
# Dino World Development - .gitignore
# ==========================================

# Explicitly excluded HTML folder
/html/
html/

# WordPress Core & Config files
wp-config.php

# WordPress Content & Generated Folders

wp-content/cache/
wp-content/upgrade/
wp-content/backup-*/
wp-content/backups/
wp-content/blogs.dir/
wp-content/mu-plugins/
wp-content/debug.log
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs & Databases
*.log
*.sql
*.sql.gz
*.sqlite

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Dependency & Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.sass-cache/
dist/
build/