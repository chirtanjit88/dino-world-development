{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "dino-world/container",
  "title": "Custom Container",
  "description": "Simple container block that wraps any inner blocks inside the theme fixed container width (1440px).",
  "category": "dino-world-blocks",
  "icon": "layout",
  "keywords": [
    "container",
    "section",
    "wrapper",
    "row",
    "width",
    "layout"
  ],
  "editorStyle": "file:./container-editor.css",
  "acf": {
    "mode": "preview",
    "renderTemplate": "container.php"
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": [
      "full",
      "wide"
    ],
    "anchor": true,
    "customClassName": true,
    "jsx": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  }
}
